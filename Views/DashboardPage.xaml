<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SigaCean.Views"
             x:Class="SigaCean.Views.DashboardPage"
             Title="Painel">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18">

            <Label Text="Painel" Style="{StaticResource PageTitle}" />
            <Label Text="O que precisa de atenção no estoque hoje. Clique em um quadro para ver os produtos." Style="{StaticResource PageSubtitle}" />

            <!-- Atalhos para registrar uma entrada ou uma saída. -->
            <HorizontalStackLayout Spacing="10">
                <Button Text="+ Entrada" Style="{StaticResource GreenButton}" Clicked="OnEntradaClicked" />
                <Button Text="− Saída" Style="{StaticResource OrangeButton}" Clicked="OnSaidaClicked" />
            </HorizontalStackLayout>

            <!-- Indicadores: os números vêm do EstoqueService. Clicar em um quadro abre o Estoque já filtrado. -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQuadroTapped" CommandParameter="SemEstoque" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Sem estoque" Style="{StaticResource MutedLabel}" />
                        <Label x:Name="SemEstoqueLabel" Text="0" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Red}" />
                        <Label x:Name="SemEstoqueContagem" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQuadroTapped" CommandParameter="AbaixoDoMinimo" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Abaixo do mínimo" Style="{StaticResource MutedLabel}" />
                        <Label x:Name="AbaixoDoMinimoLabel" Text="0" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Orange}" />
                        <Label x:Name="AbaixoDoMinimoContagem" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQuadroTapped" CommandParameter="Vencidos" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Vencidos" Style="{StaticResource MutedLabel}" />
                        <Label x:Name="VencidosLabel" Text="0" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Red}" />
                        <Label x:Name="VencidosContagem" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="3" Padding="16,14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQuadroTapped" CommandParameter="ValidadeProxima" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Validade próxima" Style="{StaticResource MutedLabel}" />
                        <Label x:Name="ProximosLabel" Text="0" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Orange}" />
                        <Label x:Name="ProximosContagem" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label x:Name="TotalLabel" Style="{StaticResource MutedLabel}" />

            <!-- Produtos que precisam de atenção -->
            <Label Text="Precisam de atenção" Style="{StaticResource CardTitle}" />
            <Label x:Name="AtencaoVazioLabel" Text="Nenhum produto precisa de atenção agora." Style="{StaticResource MutedLabel}" IsVisible="False" />
            <VerticalStackLayout x:Name="AtencaoLista" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="views:ProdutoLinha">
                        <Border Padding="16,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Nome}" FontAttributes="Bold" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Border Style="{StaticResource Selo}" BackgroundColor="#FBE5E5" IsVisible="{Binding SemEstoque}">
                                            <Label Text="Sem estoque" Style="{StaticResource SeloTexto}" TextColor="{StaticResource Red}" />
                                        </Border>
                                        <Border Style="{StaticResource Selo}" BackgroundColor="#FDEFD8" IsVisible="{Binding AbaixoDoMinimo}">
                                            <Label Text="Abaixo do mínimo" Style="{StaticResource SeloTexto}" TextColor="#B96F0A" />
                                        </Border>
                                        <Border Style="{StaticResource Selo}" BackgroundColor="#FBE5E5" IsVisible="{Binding Vencido}">
                                            <Label Text="Validade vencida" Style="{StaticResource SeloTexto}" TextColor="{StaticResource Red}" />
                                        </Border>
                                        <Border Style="{StaticResource Selo}" BackgroundColor="#FDEFD8" IsVisible="{Binding ValidadeProxima}">
                                            <Label Text="Vence em breve" Style="{StaticResource SeloTexto}" TextColor="#B96F0A" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label Text="{Binding Quantidade}" TextColor="{Binding CorQuantidade}" FontAttributes="Bold" FontSize="20" HorizontalOptions="End" />
                                    <Label Text="{Binding MinimoTexto}" IsVisible="{Binding MostrarMinimo}" Style="{StaticResource MutedLabel}" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Movimentações recentes -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Grid.Column="0" Text="Últimas movimentações" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Ver todas" Clicked="OnVerTodasClicked" Padding="12,4" MinimumHeightRequest="32" />
            </Grid>
            <Label x:Name="MovimentacoesVazioLabel" Text="Nenhuma movimentação registrada ainda." Style="{StaticResource MutedLabel}" IsVisible="False" />
            <VerticalStackLayout x:Name="MovimentacoesLista" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="views:MovimentacaoLinha">
                        <Border Padding="16,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding TipoTexto}" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="12" />
                                        <Label Text="{Binding DataTexto}" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding StatusTexto}" IsVisible="{Binding MostrarStatus}" TextColor="{Binding CorStatus}" FontSize="12" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Produto}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding QuantidadeTexto}" TextColor="{Binding CorQuantidade}" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
