<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:SigaCean.Views"
             x:Class="SigaCean.Views.ProdutosPage"
             Title="Produtos">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="28,24,28,12" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Grid.Column="0" Spacing="4">
                <Label Text="Produtos" Style="{StaticResource PageTitle}" />
                <Label Text="Cadastre e altere os produtos controlados pelo CEAN." Style="{StaticResource PageSubtitle}" />
            </VerticalStackLayout>
            <Button x:Name="NovoButton" Grid.Column="1" Text="Novo produto" Style="{StaticResource PrimaryButton}" VerticalOptions="Start" Clicked="OnNovoClicked" />
        </Grid>

        <!-- Formulário: aparece ao clicar em "Novo produto" ou "Editar". -->
        <Border x:Name="FormularioCard" Grid.Row="1" Padding="20" IsVisible="False">
            <VerticalStackLayout Spacing="14">
                <Label x:Name="FormularioTitulo" Text="Novo produto" Style="{StaticResource CardTitle}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                        <Label Text="Nome *" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="NomeEntry" Placeholder="Ex.: Dipirona" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                        <Label Text="Categoria *" Style="{StaticResource FieldLabel}" />
                        <Picker x:Name="CategoriaPicker" Title="Escolha a categoria" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                        <Label Text="Apresentação" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="ApresentacaoEntry" Placeholder="Ex.: Ampola, frasco 100 ml" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                        <Label Text="Especificação" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="EspecificacaoEntry" Placeholder="Ex.: 50 mg, injetável" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="6">
                        <Label Text="Quantidade mínima" Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="MinimoEntry" Placeholder="Opcional" Keyboard="Numeric" Completed="OnSalvarClicked" />
                    </VerticalStackLayout>
                </Grid>

                <Label x:Name="AvisoQuantidadeLabel" Text="A quantidade em estoque não é alterada aqui: use Entrada, Saída ou Ajuste de balanço." Style="{StaticResource MutedLabel}" />
                <Label x:Name="MensagemErroLabel" TextColor="{StaticResource Red}" IsVisible="False" />

                <HorizontalStackLayout Spacing="10">
                    <Button Text="Salvar" Style="{StaticResource PrimaryButton}" Clicked="OnSalvarClicked" />
                    <Button Text="Cancelar" Clicked="OnCancelarClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,220" ColumnSpacing="10">
            <Entry x:Name="BuscaEntry" Grid.Column="0" Placeholder="Buscar por nome do produto" TextChanged="OnFiltroChanged" />
            <Picker x:Name="FiltroCategoriaPicker" Grid.Column="1" Title="Categoria" SelectedIndexChanged="OnFiltroChanged" />
        </Grid>

        <Label x:Name="ResumoLabel" Grid.Row="3" Style="{StaticResource MutedLabel}" />

        <CollectionView x:Name="ListaProdutos" Grid.Row="4" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="Nada para mostrar." Style="{StaticResource MutedLabel}" Margin="4,20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:ProdutoLinha">
                    <Border Padding="18,14">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Detalhe}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding MinimoTexto}" IsVisible="{Binding MostrarMinimo}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding Quantidade}" TextColor="{Binding CorQuantidade}" FontAttributes="Bold" FontSize="22" HorizontalOptions="End" />
                                <Label Text="em estoque" Style="{StaticResource MutedLabel}" HorizontalOptions="End" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Editar" VerticalOptions="Center" Clicked="OnEditarClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
