<?xml version="1.0" encoding="utf-8" ?>
<VerticalStackLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="SigaCean.Views.SeletorPeriodoView"
                     Spacing="10">

    <!-- Tipo do período: mensal, trimestral, anual ou personalizado. O escolhido fica preenchido (estilos Chip e ChipEscolhido). -->
    <FlexLayout Wrap="Wrap">
        <Button x:Name="MensalButton" Text="Mensal" Style="{StaticResource Chip}" Clicked="OnTipoClicked" CommandParameter="Mensal" Margin="0,0,8,8" />
        <Button x:Name="TrimestralButton" Text="Trimestral" Style="{StaticResource Chip}" Clicked="OnTipoClicked" CommandParameter="Trimestral" Margin="0,0,8,8" />
        <Button x:Name="AnualButton" Text="Anual" Style="{StaticResource Chip}" Clicked="OnTipoClicked" CommandParameter="Anual" Margin="0,0,8,8" />
        <Button x:Name="PersonalizadoButton" Text="Período personalizado" Style="{StaticResource Chip}" Clicked="OnTipoClicked" CommandParameter="Personalizado" Margin="0,0,8,8" />
    </FlexLayout>

    <!-- Mensal, trimestral e anual: setas com o nome do período no meio. -->
    <Grid x:Name="NavegacaoLayout" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Button Grid.Column="0" Text="Anterior" Style="{StaticResource Chip}" Clicked="OnAnteriorClicked" />
        <Label Grid.Column="1" x:Name="PeriodoLabel" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center" />
        <Button Grid.Column="2" Text="Próximo" Style="{StaticResource Chip}" Clicked="OnProximoClicked" />
    </Grid>

    <!-- Período personalizado: duas datas e "Aplicar". -->
    <Grid x:Name="PersonalizadoLayout" ColumnDefinitions="*,*,Auto" ColumnSpacing="10" IsVisible="False">
        <VerticalStackLayout Grid.Column="0">
            <Label Text="De" Style="{StaticResource FieldLabel}" />
            <DatePicker x:Name="DataInicioPicker" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="1">
            <Label Text="Até" Style="{StaticResource FieldLabel}" />
            <DatePicker x:Name="DataFimPicker" />
        </VerticalStackLayout>
        <Button Grid.Column="2" Text="Aplicar" Style="{StaticResource PrimaryButton}" Clicked="OnAplicarClicked" VerticalOptions="End" />
    </Grid>

    <Label x:Name="MensagemLabel" TextColor="{StaticResource Red}" IsVisible="False" />

</VerticalStackLayout>
